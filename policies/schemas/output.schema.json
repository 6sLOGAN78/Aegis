{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AegisPolicyOutput",
  "type": "object",
  "required": ["allow", "reason_code", "snapshot_version"],
  "additionalProperties": false,
  "properties": {
    "allow": {
      "type": "boolean"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
